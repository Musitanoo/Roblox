{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roblox-top1.local/schemas/blender-invariant-report.schema.json",
  "title": "Blender Invariant Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "status", "requested", "checks", "allKnownChecks"],
  "properties": {
    "$schema": {"const": "https://roblox-top1.local/schemas/blender-invariant-report.schema.json"},
    "schemaVersion": {"const": "1.0.0"},
    "status": {"enum": ["PASS", "FAIL"]},
    "requested": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "checks": {"type": "object", "additionalProperties": {"$ref": "#/$defs/check"}},
    "allKnownChecks": {"type": "object", "additionalProperties": {"$ref": "#/$defs/check"}}
  },
  "$defs": {
    "check": {"type": "object", "required": ["passed"], "properties": {"passed": {"type": "boolean"}}, "additionalProperties": true}
  }
}
