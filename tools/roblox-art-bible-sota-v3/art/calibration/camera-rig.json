      "derivedCameraHeightStuds": 4.145129
    },
    "three_quarter": {
      "distanceStuds": 22.0,
      "azimuthDegrees": 35.0,
      "elevationDegrees": 16.0,
      "targetHeightStuds": 2.75,
      "derivedCameraHeightStuds": 8.814022
