{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roblox-top1.local/schemas/faction-palettes.schema.json",
  "type": "object",
  "required": [
    "$schema",
    "schemaVersion",
    "factions",
    "rule"
  ],
  "properties": {
    "$schema": {
      "const": "https://roblox-top1.local/schemas/faction-palettes.schema.json"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "factions": {
      "type": "object",
      "minProperties": 3,
      "properties": {
        "enemy_horde": {
          "type": "object",
          "properties": {
            "accent": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 2,
              "maxItems": 2
            },
            "base": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 2,
              "maxItems": 2
            },
            "dangerOverride": {
              "type": "string",
              "minLength": 1
            },
            "shapeFamily": {
              "type": "string",
              "minLength": 1
            }
          },
          "unevaluatedProperties": false,
          "required": [
            "accent",
            "base",
            "dangerOverride",
            "shapeFamily"
          ]
        },
        "objective_system": {
          "type": "object",
          "properties": {
            "accent": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 2,
              "maxItems": 2
            },
            "base": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 2,
              "maxItems": 2
            },
            "dangerOverride": {
              "type": "string",
              "minLength": 1
            },
            "shapeFamily": {
              "type": "string",
              "minLength": 1
            }
          },
          "unevaluatedProperties": false,
          "required": [
            "accent",
            "base",
            "dangerOverride",
            "shapeFamily"
          ]
        },
        "player_fortress": {
          "type": "object",
          "properties": {
            "accent": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 2,
              "maxItems": 2
            },
            "base": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 2,
              "maxItems": 2
            },
            "dangerOverride": {
              "type": "string",
              "minLength": 1
            },
            "shapeFamily": {
              "type": "string",
              "minLength": 1
            }
          },
          "unevaluatedProperties": false,
          "required": [
            "accent",
            "base",
            "dangerOverride",
            "shapeFamily"
          ]
        }
      },
      "unevaluatedProperties": false,
      "required": [
        "enemy_horde",
        "objective_system",
        "player_fortress"
      ]
    },
    "rule": {
      "type": "string",
      "minLength": 20
    }
  },
  "unevaluatedProperties": false
}
