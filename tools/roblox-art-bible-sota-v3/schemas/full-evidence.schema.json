{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roblox-top1.local/schemas/full-evidence.schema.json",
  "title": "Blender Full Evidence Attestation",
  "type": "object",
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "render": {
      "type": "object",
      "required": ["jobId", "path", "sha256"],
      "properties": {
        "jobId": {"type": "string", "minLength": 1},
        "path": {"type": "string", "pattern": "^build/[^/]+/renders/full/.+\\.png$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "unevaluatedProperties": false
    },
    "stress": {
      "type": "object",
      "required": ["sceneId", "count", "path", "sha256"],
      "properties": {
        "sceneId": {"enum": ["stress_barricade_30", "stress_enemy_standard_30"]},
        "count": {"const": 30},
        "path": {"type": "string", "pattern": "^build/[^/]+/renders/full/.+\\.png$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "unevaluatedProperties": false
    },
    "territory": {
      "type": "object",
      "required": ["territoryId", "status", "buildReportSha256", "inputHashes", "expectedRenderCount", "actualRenderCount", "renderEvidenceComplete", "renderEvidence", "stressEvidence"],
      "properties": {
        "territoryId": {"enum": ["industrial-toy-defense", "salvaged-frontier", "clean-tactical-diorama"]},
        "status": {"const": "PASS"},
        "buildReportSha256": {"$ref": "#/$defs/sha256"},
        "inputHashes": {
          "type": "object",
          "required": ["territory", "calibration", "camera", "renderMatrix", "lighting", "generator"],
          "additionalProperties": {"$ref": "#/$defs/sha256"}
        },
        "expectedRenderCount": {"const": 421},
        "actualRenderCount": {"const": 421},
        "renderEvidenceComplete": {"const": true},
        "renderEvidence": {"type": "array", "minItems": 421, "maxItems": 421, "items": {"$ref": "#/$defs/render"}},
        "stressEvidence": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/stress"}}
      },
      "unevaluatedProperties": false
    }
  },
  "required": ["$schema", "schemaVersion", "status", "generatedAt", "evidenceTier", "rendererTruth", "territories", "totalExpectedRenderCount", "totalActualRenderCount", "totalStressRenderCount", "artifactsBundled", "artifactRetentionNote", "issues"],
  "properties": {
    "$schema": {"const": "https://roblox-top1.local/schemas/full-evidence.schema.json"},
    "schemaVersion": {"const": "3.1.0"},
    "status": {"const": "PASS"},
    "generatedAt": {"type": "string", "format": "date-time"},
    "evidenceTier": {"const": "FULL_COMPLETE"},
    "rendererTruth": {"const": "BLENDER_PREFLIGHT_ONLY_STUDIO_IS_CANONICAL"},
    "territories": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/territory"}},
    "totalExpectedRenderCount": {"const": 1263},
    "totalActualRenderCount": {"const": 1263},
    "totalStressRenderCount": {"const": 6},
    "artifactsBundled": {"const": false},
    "artifactRetentionNote": {"type": "string", "minLength": 1},
    "issues": {"type": "array", "maxItems": 0, "items": {"type": "string"}}
  },
  "unevaluatedProperties": false
}
