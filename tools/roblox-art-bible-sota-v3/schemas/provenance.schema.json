{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roblox-top1.local/schemas/provenance.schema.json",
  "type": "object",
  "required": [
    "$schema",
    "schemaVersion",
    "policy",
    "humanApproval",
    "references"
  ],
  "properties": {
    "$schema": {
      "const": "https://roblox-top1.local/schemas/provenance.schema.json"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "policy": {
      "type": "object",
      "properties": {
        "boardMethod": {
          "type": "string",
          "minLength": 1
        },
        "embedOnlyWhenRedistributable": {
          "type": "boolean"
        },
        "logosAndExactAssetSilhouettesForbidden": {
          "type": "boolean"
        },
        "minimumReferencesPerTerritory": {
          "type": "number",
          "minimum": 0
        },
        "unknownLicenseBlocksProductionUse": {
          "type": "boolean"
        }
      },
      "unevaluatedProperties": false,
      "required": [
        "boardMethod",
        "embedOnlyWhenRedistributable",
        "logosAndExactAssetSilhouettesForbidden",
        "minimumReferencesPerTerritory",
        "unknownLicenseBlocksProductionUse"
      ]
    },
    "humanApproval": {
      "type": "object",
      "required": ["status", "reviewer", "reviewedAt", "decisionRecord"],
      "properties": {
        "status": {"enum": ["PENDING", "APPROVED", "REJECTED"]},
        "reviewer": {"type": ["string", "null"], "minLength": 2},
        "reviewedAt": {"type": ["string", "null"], "format": "date-time"},
        "decisionRecord": {"type": ["string", "null"], "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "APPROVED"}}, "required": ["status"]},
          "then": {
            "properties": {
              "reviewer": {"type": "string", "minLength": 2},
              "reviewedAt": {"type": "string", "format": "date-time"},
              "decisionRecord": {"type": "string", "minLength": 1}
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "references": {
      "type": "array",
      "minItems": 36,
      "items": {
        "type": "object",
        "required": [
          "referenceId",
          "territoryId",
          "title",
          "sourceUrl",
          "sourceOwner",
          "retrievedAt",
          "licenseStatus",
          "embeddedInRepository",
          "approvedStatus",
          "allowedUse",
          "extractableCues",
          "copyProhibition"
        ],
        "properties": {
          "referenceId": {
            "type": "string",
            "pattern": "^[a-z]{2,3}-[0-9]{2}$"
          },
          "territoryId": {
            "enum": [
              "industrial-toy-defense",
              "salvaged-frontier",
              "clean-tactical-diorama"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 4
          },
          "sourceUrl": {
            "type": "string",
            "format": "uri"
          },
          "sourceOwner": {
            "type": "string",
            "minLength": 2
          },
          "retrievedAt": {
            "type": "string",
            "format": "date"
          },
          "licenseStatus": {
            "enum": [
              "public_domain",
              "cc0",
              "official_documentation",
              "official_standard",
              "official_reference_inspiration_only",
              "unknown_blocked"
            ]
          },
          "embeddedInRepository": {
            "type": "boolean"
          },
          "approvedStatus": {
            "enum": [
              "research_seed",
              "approved_inspiration",
              "approved_redistributable",
              "rejected"
            ]
          },
          "allowedUse": {
            "enum": [
              "principle_extraction_only",
              "redistributable_asset"
            ]
          },
          "extractableCues": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string"
            }
          },
          "copyProhibition": {
            "type": "string",
            "minLength": 40
          }
        },
        "unevaluatedProperties": false
      }
    }
  },
  "unevaluatedProperties": false
}
