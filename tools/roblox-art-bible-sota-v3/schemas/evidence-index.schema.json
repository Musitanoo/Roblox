{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roblox-top1.local/schemas/evidence-index.schema.json",
  "type": "object",
  "required": [
    "$schema",
    "schemaVersion",
    "status",
    "selectedTerritory",
    "items"
  ],
  "properties": {
    "$schema": {
      "const": "https://roblox-top1.local/schemas/evidence-index.schema.json"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "enum": [
        "INCOMPLETE",
        "COMPLETE"
      ]
    },
    "selectedTerritory": {
      "enum": [
        "industrial-toy-defense",
        "salvaged-frontier",
        "clean-tactical-diorama"
      ]
    },
    "items": {
      "type": "array",
      "minItems": 15,
      "items": {
        "type": "object",
        "properties": {
          "gateId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_\\-]*$"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "BLOCKED",
              "UNKNOWN"
            ]
          },
          "path": {
            "type": [
              "string",
              "null"
            ]
          },
          "sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "observedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "notes": {
            "type": "string"
          }
        },
        "required": [
          "gateId",
          "status",
          "path",
          "sha256",
          "observedAt",
          "notes"
        ],
        "unevaluatedProperties": false
      }
    }
  },
  "unevaluatedProperties": false
}
