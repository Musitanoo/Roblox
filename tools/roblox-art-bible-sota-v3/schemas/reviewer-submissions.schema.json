{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roblox-top1.local/schemas/reviewer-submissions.schema.json",
  "type": "object",
  "required": [
    "$schema",
    "schemaVersion",
    "studyId",
    "status",
    "sealedAt",
    "participants",
    "expertReviews",
    "technicalEvidenceByBlindLabel"
  ],
  "properties": {
    "$schema": {
      "const": "https://roblox-top1.local/schemas/reviewer-submissions.schema.json"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "studyId": {
      "type": "string"
    },
    "status": {
      "enum": [
        "DRAFT",
        "SEALED"
      ]
    },
    "sealedAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "participants": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "properties": {
          "participantId": {
            "type": "string",
            "pattern": "^P[0-9]{2,4}$"
          },
          "deviceClass": {
            "enum": [
              "mobile",
              "tablet",
              "desktop"
            ]
          },
          "responses": {
            "type": "array",
            "minItems": 9,
            "items": {
              "type": "object",
              "properties": {
                "blindLabel": {
                  "enum": [
                    "A",
                    "B",
                    "C"
                  ]
                },
                "taskId": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_\\-]*$"
                },
                "correct": {
                  "type": "boolean"
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "responseTimeMs": {
                  "type": "integer",
                  "minimum": 50,
                  "maximum": 300000
                }
              },
              "required": [
                "blindLabel",
                "taskId",
                "correct",
                "confidence",
                "responseTimeMs"
              ],
              "unevaluatedProperties": false
            }
          }
        },
        "required": [
          "participantId",
          "deviceClass",
          "responses"
        ],
        "unevaluatedProperties": false
      }
    },
    "expertReviews": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "properties": {
          "reviewerId": {
            "type": "string",
            "pattern": "^R[0-9]{2,4}$"
          },
          "ratings": {
            "type": "array",
            "minItems": 27,
            "items": {
              "type": "object",
              "properties": {
                "blindLabel": {
                  "enum": [
                    "A",
                    "B",
                    "C"
                  ]
                },
                "dimensionId": {
                  "type": "string"
                },
                "score": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 5
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": [
                "blindLabel",
                "dimensionId",
                "score",
                "confidence"
              ],
              "unevaluatedProperties": false
            }
          }
        },
        "required": [
          "reviewerId",
          "ratings"
        ],
        "unevaluatedProperties": false
      }
    },
    "technicalEvidenceByBlindLabel": {
      "type": "object",
      "required": [
        "A",
        "B",
        "C"
      ],
      "properties": {
        "A": {
          "type": "object",
          "minProperties": 9,
          "additionalProperties": false,
          "patternProperties": {
            "^[a-z][a-z0-9_]+$": {
              "type": "object",
              "properties": {
                "pass": {
                  "type": "boolean"
                },
                "evidencePath": {
                  "type": "string",
                  "minLength": 3
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "pass",
                "evidencePath",
                "sha256"
              ],
              "unevaluatedProperties": false
            }
          }
        },
        "B": {
          "type": "object",
          "minProperties": 9,
          "additionalProperties": false,
          "patternProperties": {
            "^[a-z][a-z0-9_]+$": {
              "type": "object",
              "properties": {
                "pass": {
                  "type": "boolean"
                },
                "evidencePath": {
                  "type": "string",
                  "minLength": 3
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "pass",
                "evidencePath",
                "sha256"
              ],
              "unevaluatedProperties": false
            }
          }
        },
        "C": {
          "type": "object",
          "minProperties": 9,
          "additionalProperties": false,
          "patternProperties": {
            "^[a-z][a-z0-9_]+$": {
              "type": "object",
              "properties": {
                "pass": {
                  "type": "boolean"
                },
                "evidencePath": {
                  "type": "string",
                  "minLength": 3
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "pass",
                "evidencePath",
                "sha256"
              ],
              "unevaluatedProperties": false
            }
          }
        }
      },
      "unevaluatedProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "SEALED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "sealedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
