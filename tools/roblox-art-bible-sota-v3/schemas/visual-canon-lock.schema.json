{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roblox-top1.local/schemas/visual-canon-lock.schema.json",
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "type": "object",
  "required": [
    "$schema",
    "schemaVersion",
    "assetId",
    "territoryId",
    "version",
    "status",
    "baseCandidateSha256",
    "evidenceClass",
    "evidenceManifest",
    "humanReview",
    "visualEvidencePackageSha256",
    "boards",
    "approval"
  ],
  "properties": {
    "$schema": {"const": "https://roblox-top1.local/schemas/visual-canon-lock.schema.json"},
    "schemaVersion": {"const": "1.1.0"},
    "assetId": {"enum": ["barricade", "objective_core", "enemy_standard", "floor_module", "damage_effect", "turret_fast_v1"]},
    "territoryId": {"enum": ["industrial-toy-defense", "salvaged-frontier", "clean-tactical-diorama"]},
    "version": {"type": "integer", "minimum": 1},
    "status": {"enum": ["LOCKED", "REVISED"]},
    "baseCandidateSha256": {"$ref": "#/$defs/sha256"},
    "evidenceClass": {"const": "REAL_RENDERED"},
    "evidenceManifest": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 3},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "unevaluatedProperties": false
    },
    "humanReview": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 3},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "unevaluatedProperties": false
    },
    "visualEvidencePackageSha256": {"$ref": "#/$defs/sha256"},
    "boards": {
      "type": "object",
      "minProperties": 17,
      "maxProperties": 17,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["path", "sha256"],
          "properties": {
            "path": {"type": "string", "minLength": 3},
            "sha256": {"$ref": "#/$defs/sha256"}
          },
          "unevaluatedProperties": false
        }
      }
    },
    "approval": {
      "type": "object",
      "required": ["approvedBy", "approvedAt", "decisionRecord", "revisionReason"],
      "properties": {
        "approvedBy": {"type": "string", "minLength": 2},
        "approvedAt": {"type": "string", "format": "date-time"},
        "decisionRecord": {"type": "string", "minLength": 3},
        "revisionReason": {"type": ["string", "null"]}
      },
      "unevaluatedProperties": false
    }
  },
  "unevaluatedProperties": false
}
