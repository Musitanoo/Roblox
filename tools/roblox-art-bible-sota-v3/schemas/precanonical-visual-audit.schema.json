{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roblox-top1.local/schemas/precanonical-visual-audit.schema.json",
  "type": "object",
  "properties": {
    "$schema": {
      "const": "https://roblox-top1.local/schemas/precanonical-visual-audit.schema.json"
    },
    "schemaVersion": {"const": "1.0.0"},
    "auditId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
    "auditedAt": {"type": "string", "format": "date-time"},
    "scope": {
      "type": "object",
      "properties": {
        "originalStage": {"const": "exploration"},
        "downstreamUse": {"const": "state_definition"},
        "observableEvidenceOnly": {"const": true},
        "limitations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 3}
        }
      },
      "required": ["originalStage", "downstreamUse", "observableEvidenceOnly", "limitations"],
      "unevaluatedProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "request": {"$ref": "#/$defs/binding"},
        "result": {"$ref": "#/$defs/binding"},
        "review": {"$ref": "#/$defs/binding"},
        "image": {"$ref": "#/$defs/binding"},
        "resultDigest": {"$ref": "#/$defs/sha256"},
        "modelNameEvidence": {"const": "NOT_CONFIRMED"}
      },
      "required": ["request", "result", "review", "image", "resultDigest", "modelNameEvidence"],
      "unevaluatedProperties": false
    },
    "verdict": {"const": "REVISION_REQUIRED"},
    "strengthsToPreserve": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 3}
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/finding"}
    },
    "acceptanceForNextGeneration": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 3}
    },
    "canonical": {"const": false},
    "productionApproved": {"const": false}
  },
  "required": [
    "$schema",
    "schemaVersion",
    "auditId",
    "auditedAt",
    "scope",
    "evidence",
    "verdict",
    "strengthsToPreserve",
    "findings",
    "acceptanceForNextGeneration",
    "canonical",
    "productionApproved"
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "binding": {
      "type": "object",
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "required": ["path", "sha256"],
      "unevaluatedProperties": false
    },
    "finding": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "pattern": "^F-[0-9]{3}$"},
        "category": {
          "enum": ["composition", "continuity", "function", "art_direction", "materials", "mechanics", "perception", "evidence", "review_gate", "provenance"]
        },
        "severity": {"enum": ["BLOCKING", "HIGH", "MEDIUM", "LOW"]},
        "originalStageAssessment": {"enum": ["VIOLATION", "LIMITATION", "NOT_APPLICABLE"]},
        "downstreamImpact": {"enum": ["BLOCKING", "DEGRADING", "NONE"]},
        "problem": {"type": "string", "minLength": 3},
        "evidence": {"type": "string", "minLength": 3},
        "correction": {"type": "string", "minLength": 3},
        "implementationStatus": {
          "enum": ["IMPLEMENTED", "PENDING_NEW_GENERATION", "PENDING_HUMAN_REVIEW", "UNKNOWN_BY_DESIGN"]
        }
      },
      "required": ["id", "category", "severity", "originalStageAssessment", "downstreamImpact", "problem", "evidence", "correction", "implementationStatus"],
      "unevaluatedProperties": false
    }
  },
  "unevaluatedProperties": false
}
