{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roblox-top1.local/schemas/visual-canon-source.schema.json",
  "$defs": {
    "stringList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 3}
    },
    "state": {
      "type": "object",
      "required": [
        "summary",
        "changes",
        "silhouetteCues",
        "valueCues",
        "colorCues",
        "lightCues",
        "motionCues",
        "vfxCues",
        "audioCues",
        "componentOperations",
        "transitions"
      ],
      "properties": {
        "summary": {"type": "string", "minLength": 20},
        "changes": {"$ref": "#/$defs/stringList"},
        "silhouetteCues": {"$ref": "#/$defs/stringList"},
        "valueCues": {"$ref": "#/$defs/stringList"},
        "colorCues": {"$ref": "#/$defs/stringList"},
        "lightCues": {"$ref": "#/$defs/stringList"},
        "motionCues": {"$ref": "#/$defs/stringList"},
        "vfxCues": {"$ref": "#/$defs/stringList"},
        "audioCues": {"$ref": "#/$defs/stringList"},
        "componentOperations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["componentId", "operation", "description"],
            "properties": {
              "componentId": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$"},
              "operation": {
                "enum": ["PRESERVE", "MOVE", "ROTATE", "EXPOSE", "OPEN", "BREAK", "REMOVE", "RECOLOR", "EMIT", "DEFORM"]
              },
              "description": {"type": "string", "minLength": 10}
            },
            "unevaluatedProperties": false
          }
        },
        "transitions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["to", "durationSeconds", "sequence", "reversible"],
            "properties": {
              "to": {"enum": ["intact", "damaged", "critical"]},
              "durationSeconds": {"type": "number", "minimum": 0, "maximum": 10},
              "sequence": {"$ref": "#/$defs/stringList"},
              "reversible": {"type": "boolean"}
            },
            "unevaluatedProperties": false
          }
        }
      },
      "unevaluatedProperties": false
    },
    "component": {
      "type": "object",
      "required": [
        "id",
        "function",
        "position",
        "form",
        "materialRole",
        "relationship",
        "mobility",
        "visibility",
        "readingRole"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$"},
        "function": {"type": "string", "minLength": 10},
        "position": {"type": "string", "minLength": 5},
        "form": {"type": "string", "minLength": 5},
        "materialRole": {
          "enum": ["primary", "secondary", "accent", "interaction", "threat", "warning", "critical", "rubber", "bareMetal"]
        },
        "relationship": {"type": "string", "minLength": 10},
        "mobility": {"enum": ["fixed", "mobile", "destructible", "replaceable", "ephemeral"]},
        "visibility": {"type": "string", "minLength": 10},
        "readingRole": {"type": "string", "minLength": 10}
      },
      "unevaluatedProperties": false
    },
    "asset": {
      "type": "object",
      "required": [
        "canonicalName",
        "category",
        "worldRole",
        "affiliation",
        "manufactureContext",
        "emotionalIntent",
        "technologyLevel",
        "character",
        "oneSecondPromise",
        "orientationCue",
        "interactionCue",
        "dangerCue",
        "relationToPlayer",
        "proportionRules",
        "viewDescriptions",
        "recognitionLandmarks",
        "negativeSpaces",
        "primaryForms",
        "secondaryForms",
        "tertiaryForms",
        "components",
        "semanticZones",
        "materialIntent",
        "invariants",
        "allowedVariations",
        "forbidden",
        "states"
      ],
      "properties": {
        "canonicalName": {"type": "string", "minLength": 3},
        "category": {"type": "string", "minLength": 3},
        "worldRole": {"type": "string", "minLength": 20},
        "affiliation": {"type": "string", "minLength": 3},
        "manufactureContext": {"type": "string", "minLength": 20},
        "emotionalIntent": {"type": "string", "minLength": 20},
        "technologyLevel": {"type": "string", "minLength": 10},
        "character": {"$ref": "#/$defs/stringList"},
        "oneSecondPromise": {"type": "string", "minLength": 20},
        "orientationCue": {"type": "string", "minLength": 10},
        "interactionCue": {"type": "string", "minLength": 10},
        "dangerCue": {"type": "string", "minLength": 10},
        "relationToPlayer": {"type": "string", "minLength": 10},
        "proportionRules": {"$ref": "#/$defs/stringList"},
        "viewDescriptions": {
          "type": "object",
          "required": ["front", "back", "left", "right", "top", "bottom", "threeQuarterFront", "threeQuarterBack", "gameCamera"],
          "properties": {
            "front": {"type": "string", "minLength": 20},
            "back": {"type": "string", "minLength": 20},
            "left": {"type": "string", "minLength": 20},
            "right": {"type": "string", "minLength": 20},
            "top": {"type": "string", "minLength": 20},
            "bottom": {"type": "string", "minLength": 20},
            "threeQuarterFront": {"type": "string", "minLength": 20},
            "threeQuarterBack": {"type": "string", "minLength": 20},
            "gameCamera": {"type": "string", "minLength": 20}
          },
          "unevaluatedProperties": false
        },
        "recognitionLandmarks": {"$ref": "#/$defs/stringList"},
        "negativeSpaces": {"$ref": "#/$defs/stringList"},
        "primaryForms": {"$ref": "#/$defs/stringList"},
        "secondaryForms": {"$ref": "#/$defs/stringList"},
        "tertiaryForms": {"$ref": "#/$defs/stringList"},
        "components": {
          "type": "array",
          "minItems": 3,
          "items": {"$ref": "#/$defs/component"}
        },
        "semanticZones": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": ["id", "purpose", "shapeRule", "valueRule", "colorRole", "motionRule", "vfxAnchor", "audioRole"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
              "purpose": {"type": "string", "minLength": 10},
              "shapeRule": {"type": "string", "minLength": 10},
              "valueRule": {"type": "string", "minLength": 10},
              "colorRole": {"type": "string", "minLength": 3},
              "motionRule": {"type": "string", "minLength": 5},
              "vfxAnchor": {"type": "string", "minLength": 5},
              "audioRole": {"type": "string", "minLength": 5}
            },
            "unevaluatedProperties": false
          }
        },
        "materialIntent": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["zoneId", "family", "semanticRole", "valueRange", "surfaceFinish", "wear", "boundaryRule", "lightingBehavior"],
            "properties": {
              "zoneId": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
              "family": {"type": "string", "minLength": 3},
              "semanticRole": {"type": "string", "minLength": 3},
              "valueRange": {"type": "string", "minLength": 5},
              "surfaceFinish": {"type": "string", "minLength": 10},
              "wear": {"type": "string", "minLength": 10},
              "boundaryRule": {"type": "string", "minLength": 10},
              "lightingBehavior": {"type": "string", "minLength": 10}
            },
            "unevaluatedProperties": false
          }
        },
        "invariants": {"$ref": "#/$defs/stringList"},
        "allowedVariations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "range", "justification"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
              "range": {"type": "string", "minLength": 5},
              "justification": {"type": "string", "minLength": 10}
            },
            "unevaluatedProperties": false
          }
        },
        "forbidden": {"$ref": "#/$defs/stringList"},
        "states": {
          "type": "object",
          "minProperties": 2,
          "maxProperties": 3,
          "propertyNames": {"enum": ["intact", "damaged", "critical"]},
          "additionalProperties": {"$ref": "#/$defs/state"}
        }
      },
      "unevaluatedProperties": false
    },
    "territory": {
      "type": "object",
      "required": [
        "thesis",
        "shapeGrammar",
        "exaggeration",
        "edgeLanguage",
        "detailDensity",
        "asymmetry",
        "materialLanguage",
        "paletteLogic",
        "surfaceTreatment",
        "wearLogic",
        "forbidden",
        "assetExpressions"
      ],
      "properties": {
        "thesis": {"type": "string", "minLength": 30},
        "shapeGrammar": {"$ref": "#/$defs/stringList"},
        "exaggeration": {"type": "string", "minLength": 20},
        "edgeLanguage": {"type": "string", "minLength": 20},
        "detailDensity": {"type": "string", "minLength": 20},
        "asymmetry": {"type": "string", "minLength": 20},
        "materialLanguage": {"type": "string", "minLength": 20},
        "paletteLogic": {"type": "string", "minLength": 20},
        "surfaceTreatment": {"type": "string", "minLength": 20},
        "wearLogic": {"type": "string", "minLength": 20},
        "forbidden": {"$ref": "#/$defs/stringList"},
        "assetExpressions": {
          "type": "object",
          "minProperties": 6,
          "maxProperties": 6,
          "additionalProperties": {
            "type": "object",
            "required": ["visualThesis", "constructionTranslation", "signatureDetails", "stateTranslation"],
            "properties": {
              "visualThesis": {"type": "string", "minLength": 30},
              "constructionTranslation": {"type": "string", "minLength": 30},
              "materialTranslation": {"type": "string", "minLength": 30},
              "signatureDetails": {"$ref": "#/$defs/stringList"},
              "stateTranslation": {"type": "string", "minLength": 30},
              "stateTranslations": {
                "type": "object",
                "minProperties": 1,
                "propertyNames": {"enum": ["intact", "damaged", "critical"]},
                "additionalProperties": {"type": "string", "minLength": 30}
              },
              "artDirectionOverrides": {
                "type": "object",
                "minProperties": 1,
                "properties": {
                  "thesis": {"type": "string", "minLength": 30},
                  "shapeGrammar": {"$ref": "#/$defs/stringList"},
                  "exaggeration": {"type": "string", "minLength": 20},
                  "edgeLanguage": {"type": "string", "minLength": 20},
                  "detailDensity": {"type": "string", "minLength": 20},
                  "asymmetry": {"type": "string", "minLength": 20},
                  "materialLanguage": {"type": "string", "minLength": 20},
                  "paletteLogic": {"type": "string", "minLength": 20},
                  "surfaceTreatment": {"type": "string", "minLength": 20},
                  "wearLogic": {"type": "string", "minLength": 20},
                  "forbidden": {"$ref": "#/$defs/stringList"}
                },
                "unevaluatedProperties": false
              }
            },
            "unevaluatedProperties": false
          }
        }
      },
      "unevaluatedProperties": false
    }
  },
  "type": "object",
  "required": [
    "$schema",
    "schemaVersion",
    "authoredAt",
    "authoredBy",
    "authority",
    "visualPacketBoards",
    "assets",
    "territories"
  ],
  "properties": {
    "$schema": {"const": "https://roblox-top1.local/schemas/visual-canon-source.schema.json"},
    "schemaVersion": {"const": "2.0.0"},
    "authoredAt": {"type": "string", "format": "date-time"},
    "authoredBy": {"const": "Codex under founder authority; human lock still required"},
    "authority": {
      "type": "object",
      "required": ["productArtContract", "retention", "objectProductContracts", "artDirection", "calibration", "shapeLanguage", "materials", "selectedConstitution"],
      "additionalProperties": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 3},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "unevaluatedProperties": false
      }
    },
    "visualPacketBoards": {
      "type": "array",
      "minItems": 15,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
    },
    "assets": {
      "type": "object",
      "required": ["barricade", "objective_core", "enemy_standard", "floor_module", "damage_effect", "turret_fast_v1"],
      "properties": {
        "barricade": {"$ref": "#/$defs/asset"},
        "objective_core": {"$ref": "#/$defs/asset"},
        "enemy_standard": {"$ref": "#/$defs/asset"},
        "floor_module": {"$ref": "#/$defs/asset"},
        "damage_effect": {"$ref": "#/$defs/asset"},
        "turret_fast_v1": {"$ref": "#/$defs/asset"}
      },
      "unevaluatedProperties": false
    },
    "territories": {
      "type": "object",
      "required": ["industrial-toy-defense", "salvaged-frontier", "clean-tactical-diorama"],
      "properties": {
        "industrial-toy-defense": {"$ref": "#/$defs/territory"},
        "salvaged-frontier": {"$ref": "#/$defs/territory"},
        "clean-tactical-diorama": {"$ref": "#/$defs/territory"}
      },
      "unevaluatedProperties": false
    }
  },
  "unevaluatedProperties": false
}
