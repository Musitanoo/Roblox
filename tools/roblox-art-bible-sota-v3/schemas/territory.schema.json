{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roblox-top1.local/schemas/territory.schema.json",
  "type": "object",
  "required": [
    "$schema",
    "schemaVersion",
    "territoryId",
    "status",
    "vision",
    "pillars",
    "antiPillars",
    "paletteBias",
    "blockoutPalette",
    "shapeLanguage",
    "materialBias",
    "surfaceAssignments",
    "assetRecipes",
    "referenceBoardId",
    "comparisonBudget",
    "automation"
  ],
  "properties": {
    "$schema": {
      "const": "https://roblox-top1.local/schemas/territory.schema.json"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "territoryId": {
      "enum": [
        "industrial-toy-defense",
        "salvaged-frontier",
        "clean-tactical-diorama"
      ]
    },
    "status": {
      "const": "CANDIDATE"
    },
    "vision": {
      "type": "string",
      "minLength": 40
    },
    "pillars": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "antiPillars": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "paletteBias": {
      "type": "object",
      "properties": {
        "accentSaturation": {
          "type": "number",
          "minimum": 0
        },
        "neutralTemperature": {
          "type": "string",
          "minLength": 1
        },
        "warningCoverageMax": {
          "type": "number",
          "minimum": 0
        }
      },
      "unevaluatedProperties": false,
      "required": [
        "accentSaturation",
        "neutralTemperature",
        "warningCoverageMax"
      ]
    },
    "shapeLanguage": {
      "type": "object",
      "properties": {
        "angleFamiliesDegrees": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          },
          "minItems": 3
        },
        "asymmetry": {
          "type": "object",
          "properties": {
            "max": {
              "type": "number",
              "minimum": 0
            },
            "target": {
              "type": "number",
              "minimum": 0
            }
          },
          "unevaluatedProperties": false,
          "required": [
            "max",
            "target"
          ]
        },
        "primarySecondarySizeRatio": {
          "type": "object",
          "properties": {
            "max": {
              "type": "number",
              "minimum": 0
            },
            "min": {
              "type": "number",
              "minimum": 0
            }
          },
          "unevaluatedProperties": false,
          "required": [
            "max",
            "min"
          ]
        },
        "roundness": {
          "type": "string",
          "minLength": 1
        }
      },
      "unevaluatedProperties": false,
      "required": [
        "angleFamiliesDegrees",
        "asymmetry",
        "primarySecondarySizeRatio",
        "roundness"
      ]
    },
    "materialBias": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "surfaceAssignments": {
      "type": "object",
      "required": [
        "primary",
        "secondary",
        "accent",
        "interaction",
        "threat",
        "warning",
        "critical",
        "rubber",
        "bareMetal"
      ],
      "properties": {
        "primary": {"type": "string", "pattern": "^[a-z_]+$"},
        "secondary": {"type": "string", "pattern": "^[a-z_]+$"},
        "accent": {"type": "string", "pattern": "^[a-z_]+$"},
        "interaction": {"type": "string", "pattern": "^[a-z_]+$"},
        "threat": {"type": "string", "pattern": "^[a-z_]+$"},
        "warning": {"type": "string", "pattern": "^[a-z_]+$"},
        "critical": {"type": "string", "pattern": "^[a-z_]+$"},
        "rubber": {"type": "string", "pattern": "^[a-z_]+$"},
        "bareMetal": {"type": "string", "pattern": "^[a-z_]+$"}
