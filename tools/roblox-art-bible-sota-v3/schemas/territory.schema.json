        "allowedReasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 4,
          "maxItems": 4
        },
        "maxPatchFamiliesPerAsset": {
          "type": "number",
          "minimum": 0
        },
        "maxUniqueFastenerScale": {
          "type": "number",
          "minimum": 0
        }
      },
      "unevaluatedProperties": false,
      "required": [
        "allowedReasons",
        "maxPatchFamiliesPerAsset",
        "maxUniqueFastenerScale"
      ]
    },
