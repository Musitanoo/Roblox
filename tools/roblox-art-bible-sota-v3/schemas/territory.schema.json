      "type": "object",
      "properties": {
        "revisionRounds": {
          "const": 2
        },
        "artistHoursCap": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "triangleBudgetsRef": {
          "type": "string"
        }
      },
      "required": [
        "revisionRounds",
        "artistHoursCap",
        "triangleBudgetsRef"
      ],
      "unevaluatedProperties": false
    },
    "automation": {
      "type": "object",
      "properties": {
        "deterministicSeed": {
          "type": "integer",
          "minimum": 1
