            "asymmetryTarget": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "moduleCountTarget": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            },
            "bevelRatioTarget": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 0.1
            },
            "stateBreakStrategy": {
              "type": "string",
              "minLength": 8
            },
            "detailBandTargets": {
              "type": "object",
              "properties": {
                "primary": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "secondary": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "tertiary": {
