{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roblox-top1.local/schemas/generation-authority.schema.json",
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "type": "object",
  "required": [
    "$schema",
    "schemaVersion",
    "generatedAt",
    "status",
    "mode",
    "scope",
    "territoryId",
    "catalogPath",
    "catalogSha256",
    "compilerPath",
    "compilerSha256",
    "canonBindings",
    "blockingReasons"
  ],
  "properties": {
    "$schema": {"const": "https://roblox-top1.local/schemas/generation-authority.schema.json"},
    "schemaVersion": {"const": "1.0.0"},
    "generatedAt": {"type": "string", "format": "date-time"},
    "status": {"enum": ["PASS", "BLOCKED"]},
    "mode": {"enum": ["EXPLORATION", "PRODUCTION"]},
    "scope": {"enum": ["calibration", "transfer"]},
    "territoryId": {"enum": ["industrial-toy-defense", "salvaged-frontier", "clean-tactical-diorama"]},
    "catalogPath": {"const": "art/canonical-visuals/catalog.json"},
    "catalogSha256": {"$ref": "#/$defs/sha256"},
    "compilerPath": {"type": "string", "pattern": "^tools/blender/"},
    "compilerSha256": {"$ref": "#/$defs/sha256"},
    "canonBindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["canonId", "assetId", "path", "sha256", "status", "visualPacketStatus", "productionEligible"],
        "properties": {
          "canonId": {"type": "string", "pattern": "^vc_"},
          "assetId": {"type": "string", "minLength": 3},
          "path": {"type": "string", "pattern": "^art/canonical-visuals/"},
          "sha256": {"$ref": "#/$defs/sha256"},
          "status": {"enum": ["DRAFT", "CANDIDATE", "ACCEPTED", "LOCKED", "REVISED"]},
          "visualPacketStatus": {"enum": ["SPECIFIED", "PARTIAL", "COMPLETE"]},
          "productionEligible": {"type": "boolean"}
        },
        "unevaluatedProperties": false
      }
    },
    "blockingReasons": {
      "type": "array",
      "items": {"type": "string", "minLength": 3},
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "PASS"}}, "required": ["status"]},
      "then": {"properties": {"blockingReasons": {"maxItems": 0}}}
    },
    {
      "if": {
        "properties": {
          "mode": {"const": "PRODUCTION"},
          "status": {"const": "PASS"}
        },
        "required": ["mode", "status"]
      },
      "then": {
        "properties": {
          "canonBindings": {
            "items": {
              "properties": {
                "status": {"const": "LOCKED"},
                "visualPacketStatus": {"const": "COMPLETE"},
                "productionEligible": {"const": true}
              }
            }
          }
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
