{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roblox-top1.local/schemas/static-verification-report.schema.json",
  "$defs": {
    "check": {
      "type": "object",
      "required": ["id", "required", "command", "status", "exitCode", "durationMs", "stdoutTail", "stderrTail"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "required": {"type": "boolean"},
        "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "status": {"enum": ["PASS", "FAIL", "SKIPPED"]},
        "exitCode": {"type": ["integer", "null"]},
        "durationMs": {"type": "integer", "minimum": 0},
        "stdoutTail": {"type": "string", "maxLength": 8000},
        "stderrTail": {"type": "string", "maxLength": 8000}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "SKIPPED"}}, "required": ["status"]},
          "then": {"properties": {"required": {"const": false}, "exitCode": {"type": "null"}}}
        }
      ],
      "unevaluatedProperties": false
    }
  },
  "type": "object",
  "required": ["$schema", "schemaVersion", "status", "generatedAt", "toolchain", "checks", "pytestPassed", "limitations"],
  "properties": {
    "$schema": {"const": "https://roblox-top1.local/schemas/static-verification-report.schema.json"},
    "schemaVersion": {"const": "1.0.0"},
    "status": {"enum": ["PASS", "FAIL"]},
    "generatedAt": {"type": "string", "format": "date-time"},
    "toolchain": {
      "type": "object",
      "required": ["pythonVersion", "platform", "bashAvailable", "powershellAvailable", "blenderAvailable", "luauAnalyzeAvailable", "seleneAvailable", "styluaAvailable", "rojoAvailable"],
      "properties": {
        "pythonVersion": {"type": "string", "minLength": 3},
        "platform": {"type": "string", "minLength": 3},
        "bashAvailable": {"type": "boolean"},
        "powershellAvailable": {"type": "boolean"},
        "blenderAvailable": {"type": "boolean"},
        "luauAnalyzeAvailable": {"type": "boolean"},
        "seleneAvailable": {"type": "boolean"},
        "styluaAvailable": {"type": "boolean"},
        "rojoAvailable": {"type": "boolean"}
      },
      "unevaluatedProperties": false
    },
    "checks": {"type": "array", "minItems": 4, "items": {"$ref": "#/$defs/check"}},
    "pytestPassed": {"type": "integer", "minimum": 0},
    "limitations": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  },
  "unevaluatedProperties": false
}
