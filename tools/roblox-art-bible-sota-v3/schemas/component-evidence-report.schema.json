{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roblox-top1.local/schemas/component-evidence-report.schema.json",
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "semanticObject": {
      "type": "object",
      "required": ["name", "materialRole", "detailBand"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "materialRole": {"enum": ["primary", "secondary", "accent", "interaction", "threat", "warning", "critical", "rubber", "bareMetal"]},
        "detailBand": {"enum": ["primary", "secondary", "tertiary"]}
      },
      "unevaluatedProperties": false
    }
  },
  "type": "object",
  "required": ["$schema", "schemaVersion", "generatedAt", "status", "territoryId", "source", "assets", "issues"],
  "properties": {
    "$schema": {"const": "https://roblox-top1.local/schemas/component-evidence-report.schema.json"},
    "schemaVersion": {"const": "1.0.0"},
    "generatedAt": {"type": "string", "format": "date-time"},
    "status": {"enum": ["PASS", "FAIL"]},
    "territoryId": {"enum": ["industrial-toy-defense", "salvaged-frontier", "clean-tactical-diorama"]},
    "source": {
      "type": "object",
      "required": ["blendPath", "blendSha256", "buildReportPath", "buildReportSha256", "inspectorSha256"],
      "properties": {
        "blendPath": {"type": "string", "minLength": 3},
        "blendSha256": {"$ref": "#/$defs/sha256"},
        "buildReportPath": {"type": "string", "minLength": 3},
        "buildReportSha256": {"$ref": "#/$defs/sha256"},
        "inspectorSha256": {"$ref": "#/$defs/sha256"}
      },
      "unevaluatedProperties": false
    },
    "assets": {
      "type": "array",
      "maxItems": 13,
      "items": {
        "type": "object",
        "required": ["assetId", "stateId", "semanticObjects"],
        "properties": {
          "assetId": {"enum": ["barricade", "objective_core", "enemy_standard", "floor_module", "damage_effect"]},
          "stateId": {"enum": ["intact", "damaged", "critical"]},
          "semanticObjects": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "items": {"$ref": "#/$defs/semanticObject"}
          }
        },
        "unevaluatedProperties": false
      }
    },
    "issues": {"type": "array", "items": {"type": "string", "minLength": 3}}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "PASS"}}, "required": ["status"]},
      "then": {
        "properties": {
          "assets": {"minItems": 13, "maxItems": 13},
          "issues": {"maxItems": 0}
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
