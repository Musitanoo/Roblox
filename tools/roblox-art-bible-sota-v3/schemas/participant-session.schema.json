{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roblox-top1.local/schemas/participant-session.schema.json",
  "type": "object",
  "required": [
    "$schema",
    "schemaVersion",
    "studyId",
    "publicPackageId",
    "participantId",
    "deviceClass",
    "startedAt",
    "completedAt",
    "responses",
    "exitAnswers"
  ],
  "properties": {
    "$schema": {
      "const": "https://roblox-top1.local/schemas/participant-session.schema.json"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "studyId": {
      "type": "string",
      "minLength": 3
    },
    "publicPackageId": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "participantId": {
      "type": "string",
      "pattern": "^P[0-9]{2,4}$"
    },
    "deviceClass": {
      "enum": [
        "mobile",
        "tablet",
        "desktop"
      ]
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "completedAt": {
      "type": "string",
      "format": "date-time"
    },
    "responses": {
      "type": "array",
      "minItems": 30,
      "items": {
        "type": "object",
        "required": [
          "trialIndex",
          "blindLabel",
          "taskId",
          "answer",
          "confidence",
          "exposureMs",
          "responseTimeMs"
        ],
        "properties": {
          "trialIndex": {
            "type": "integer",
            "minimum": 0
          },
          "blindLabel": {
            "enum": [
              "A",
              "B",
              "C"
            ]
          },
          "taskId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_\\-]*$"
          },
          "answer": {
            "type": "string",
            "minLength": 2,
            "maxLength": 64
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "exposureMs": {
            "type": "integer",
            "minimum": 4900,
            "maximum": 5500
          },
          "responseTimeMs": {
            "type": "integer",
            "minimum": 50,
            "maximum": 300000
          }
        },
        "unevaluatedProperties": false
      }
    },
    "exitAnswers": {
      "type": "object",
      "required": [
        "mostMemorable",
        "easiestToUnderstand",
        "decisiveCue"
      ],
      "properties": {
        "mostMemorable": {
          "enum": [
            "A",
            "B",
            "C"
          ]
        },
        "easiestToUnderstand": {
          "enum": [
            "A",
            "B",
            "C"
          ]
        },
        "decisiveCue": {
          "type": "string",
          "minLength": 3,
          "maxLength": 500
        }
      },
      "unevaluatedProperties": false
    }
  },
  "unevaluatedProperties": false
}
