{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roblox-top-1.local/schemas/roblox-3d-asset-review-1.0.0.json",
  "title": "Roblox 3D Asset Review",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "$schema",
    "schemaVersion",
    "assetKey",
    "revision",
    "contractSha256",
    "visualCanonSha256",
    "evidenceDigest",
    "reviewStatus",
    "automationReviewStatus",
    "humanReviewStatus",
    "evidence"
  ],
  "properties": {
    "$schema": {
      "const": "https://roblox-top-1.local/schemas/roblox-3d-asset-review-1.0.0.json"
    },
    "schemaVersion": {
      "const": "1.2.0"
    },
    "assetKey": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,63}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "contractSha256": {
      "$ref": "#/$defs/sha256"
    },
    "visualCanonSha256": {
      "$ref": "#/$defs/sha256"
    },
    "evidenceDigest": {
      "type": "object",
      "additionalProperties": false,
      "description": "SHA-256 of the UTF-8 canonical JSON array of sorted {path,bytes,sha256} evidence bindings, prefixed by the scheme name and a newline.",
      "required": [
        "scheme",
        "sha256",
        "fileCount"
      ],
      "properties": {
        "scheme": {
          "const": "sha256-canonical-json-path-sha256-v1"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "fileCount": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "reviewStatus": {
      "$ref": "#/$defs/status"
    },
    "automationReviewStatus": {
      "$ref": "#/$defs/status"
    },
    "humanReviewStatus": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "PARTIAL",
        "BLOCKED",
        "UNKNOWN",
        "SKIPPED",
        "PENDING"
      ]
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/relativeEvidencePath"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "PARTIAL",
        "BLOCKED",
        "UNKNOWN",
        "SKIPPED"
      ]
    },
    "relativeEvidencePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    }
  }
}
